@keyframes content-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.78;
  }
}

.motion-content {
  animation: content-fade-in 180ms ease-out both;
}

@media (prefers-reduced-motion: reduce) {
  .motion-content {
    animation: none;
  }
}
