.type-display-large {
  font-family: "Songti SC", "STSong", serif;
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1.27;
  letter-spacing: 1rpx;
}

.type-display-medium {
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.34;
}

.type-page-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.36;
}

.type-section-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.type-body,
.type-body-strong {
  font-size: 32rpx;
  line-height: 1.5;
}

.type-body-strong {
  font-weight: 600;
}

.type-secondary {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.5;
}

.type-caption {
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.42;
}
