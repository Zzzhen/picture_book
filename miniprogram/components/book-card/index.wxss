.book-card {
  min-width: 0;
}

.book-card--pressed {
  opacity: 0.76;
}

.book-card__cover {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: var(--radius-medium);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.book-card__cover-component {
  display: block;
  width: 100%;
}

.book-card__check {
  display: flex;
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 2;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  color: #fff;
  background: rgba(32, 37, 31, 0.42);
  font-size: 24rpx;
}

.book-card__check--selected {
  background: var(--color-brand-forest);
}

.book-card--selected .book-card__cover {
  transform: translateY(-2rpx);
  box-shadow: 0 0 0 5rpx var(--color-brand-forest), 0 12rpx 24rpx rgba(35, 78, 58, 0.18);
}

.book-card--selected .book-card__cover::after {
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: var(--radius-medium);
  background: rgba(35, 78, 58, 0.12);
  content: "";
}

.book-card__title,
.book-card__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-card__title {
  margin-top: 16rpx;
  color: var(--color-text-primary);
  font-size: 27rpx;
  font-weight: 600;
}

.book-card__meta {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}
