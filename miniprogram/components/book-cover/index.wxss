.cover {
  overflow: hidden;
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: var(--radius-md);
  background: #e9e1d2;
  box-shadow: var(--shadow-cover);
}

.cover--small {
  width: 104rpx;
}

.cover--large {
  width: 264rpx;
}

.cover__image,
.cover__fallback {
  width: 100%;
  height: 100%;
}

.cover__fallback {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 18rpx;
  color: #5b5147;
  background: #e9e1d2;
}

.cover__rule {
  width: 32rpx;
  height: 4rpx;
  margin-bottom: 12rpx;
  background: var(--color-accent-terracotta);
}

.cover__title {
  display: -webkit-box;
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 24rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.cover__badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: var(--radius-pill);
  color: #fff;
  background: var(--color-forest);
  font-size: 20rpx;
}

.cover__badge--error {
  background: var(--color-danger);
}
