<view class="cover cover--{{size}}">
  <image wx:if="{{src && !imageFailed}}" class="cover__image" src="{{src}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImageError" />
  <view wx:else class="cover__fallback">
    <view class="cover__rule"></view>
    <text class="cover__title">{{title}}</text>
  </view>
  <text wx:if="{{status === 'pending'}}" class="cover__badge">审核中</text>
  <text wx:if="{{status === 'rejected'}}" class="cover__badge cover__badge--error">需修改</text>
</view>
