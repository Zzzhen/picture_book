.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 44rpx;
  background: transparent;
  color: var(--color-brand-forest);
}

.icon-button--surface {
  border: 2rpx solid var(--color-border-default);
  background: var(--color-surface-primary);
}

.icon-button--floating {
  background: var(--color-brand-forest);
  box-shadow: var(--shadow-floating);
  color: #fff;
}

.icon-button__glyph {
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
}
