.skeleton {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 34rpx 22rpx;
}

.skeleton__cover,
.skeleton__line {
  background: linear-gradient(90deg, #ebe5db 20%, #f5f1e9 50%, #ebe5db 80%);
  background-size: 300% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton__cover {
  aspect-ratio: 3 / 4;
  border-radius: var(--radius-md);
}

.skeleton__line {
  width: 62%;
  height: 18rpx;
  margin-top: 12rpx;
  border-radius: var(--radius-pill);
}

.skeleton__line--wide {
  width: 90%;
  margin-top: 18rpx;
}

.skeleton--list {
  display: block;
}

.skeleton--list .skeleton__item {
  display: grid;
  grid-template-columns: 104rpx 1fr;
  column-gap: 22rpx;
  min-height: 150rpx;
  padding: 20rpx 0;
}

.skeleton--list .skeleton__cover {
  grid-row: 1 / 3;
  width: 104rpx;
  height: 138rpx;
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
