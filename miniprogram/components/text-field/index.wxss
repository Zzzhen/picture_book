.field {
  width: 100%;
}

.field__label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field__label {
  font-size: 28rpx;
  font-weight: 600;
}

.field__required {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.field__control {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 25rpx 24rpx;
  border: 2rpx solid var(--color-border-default);
  border-radius: var(--radius-medium);
  background: var(--color-surface-primary);
  color: var(--color-text-primary);
  font-size: 30rpx;
  line-height: 44rpx;
}

.field__control:focus {
  border-color: var(--color-brand-forest);
}

.field__textarea {
  min-height: 224rpx;
}

.field__placeholder {
  color: var(--color-text-muted);
}

.field--error .field__control {
  border-color: var(--color-state-danger);
}

.field__error {
  display: block;
  margin-top: 10rpx;
  color: var(--color-state-danger);
  font-size: 24rpx;
  line-height: 1.4;
}

.field--detail .field__label-row {
  margin-bottom: 14rpx;
}

.field--detail .field__label {
  font-family: var(--font-display);
  color: #47311c;
  font-size: 32rpx;
  font-weight: 700;
}

.field--detail .field__control {
  min-height: 158rpx;
  padding: 23rpx 22rpx;
  border: 1rpx solid #cfc1b1;
  border-radius: 20rpx;
  color: #47311c;
  background-color: rgba(252, 248, 242, 0.54);
  background-image: linear-gradient(to bottom, transparent 0, transparent 38rpx, rgba(220, 209, 196, 0.72) 39rpx, transparent 40rpx);
  background-size: 100% 40rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.field--detail .field__placeholder {
  color: #8d8175;
}
