.shelf-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.shelf-card--pressed {
  transform: translateY(1rpx);
  opacity: 0.78;
}

.shelf-card__collage {
  display: grid;
  overflow: hidden;
  flex: 0 0 152rpx;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  width: 152rpx;
  height: 116rpx;
  border-radius: var(--radius-sm);
  background: var(--color-paper-deep);
}

.shelf-card__slot {
  display: flex;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 58rpx;
  border-right: 1rpx solid rgba(216, 208, 195, 0.78);
  border-bottom: 1rpx solid rgba(216, 208, 195, 0.78);
  background: var(--color-surface-cover);
}

.shelf-card__cover {
  width: 100%;
  height: 100%;
}

.shelf-card__slot-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.shelf-card__empty-rule {
  width: 24rpx;
  height: 3rpx;
  background: rgba(49, 90, 69, 0.32);
}

.shelf-card__body {
  flex: 1;
  min-width: 0;
}

.shelf-card__name,
.shelf-card__count,
.shelf-card__description {
  display: block;
}

.shelf-card__description {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.shelf-card__name {
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shelf-card__count {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.shelf-card__arrow {
  color: var(--color-text-tertiary);
  font-size: 42rpx;
}
