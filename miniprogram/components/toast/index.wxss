.toast {
  display: flex;
  z-index: var(--z-toast);
  position: fixed;
  top: calc(env(safe-area-inset-top) + 128rpx);
  left: 50%;
  align-items: center;
  width: max-content;
  max-width: 590rpx;
  gap: 12rpx;
  padding: 18rpx 26rpx;
  transform: translateX(-50%);
  border-radius: var(--radius-pill);
  color: #fff;
  background: rgba(32, 37, 31, 0.92);
  box-shadow: var(--shadow-float);
  font-size: 25rpx;
  animation: toast-in 180ms ease-out;
}

.toast--success .toast__icon {
  color: #a7dfb9;
}

.toast--error .toast__icon {
  color: #ffbaaa;
}

.toast__icon {
  font-weight: 800;
}

@keyframes toast-in {
  from { opacity: 0; transform: translate(-50%, -10rpx); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
