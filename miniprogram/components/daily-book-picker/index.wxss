.picker {
  box-sizing: border-box;
  position: relative;
  min-height: calc(100vh - 176rpx);
  padding: 0 0 calc(36rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: #fffefb;
}

.picker__ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.picker__ambient--one {
  top: 20rpx;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;
  background: radial-gradient(circle, rgba(201, 110, 80, 0.18), transparent 68%);
}

.picker__ambient--two {
  right: -100rpx;
  bottom: 40rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(49, 90, 69, 0.24), transparent 68%);
}

.picker__deck {
  position: relative;
  width: 100%;
  height: 700rpx;
  margin-top: 0;
}

.picker__swiper {
  width: 100%;
  height: 650rpx;
}

.picker__slide {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.picker__slide-card {
  position: relative;
  width: calc(100% - 38rpx);
  opacity: 0.46;
  transform: translateY(32rpx) scale(0.86);
  transform-origin: center;
  transition: transform 260ms ease-out, opacity 220ms ease-in-out;
}

.picker__slide-card--active {
  z-index: 3;
  opacity: 1;
  transform: translateY(0) scale(1);
}

.picker__slide-card book-cover {
  display: block;
  width: 100%;
}

.picker--result .picker__slide-card--active {
  animation: focus-settle 400ms ease-out both;
}

.picker__swiper--skeleton {
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker__skeleton-card {
  width: 472rpx;
  aspect-ratio: 3 / 4;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-large);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.05));
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.28);
  animation: picker-pulse 1.2s ease-in-out infinite;
}

.picker__deck-meta {
  display: flex;
  position: absolute;
  right: 44rpx;
  bottom: 4rpx;
  left: 44rpx;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.44);
  font-size: 22rpx;
}

.picker__content {
  z-index: 5;
  box-sizing: border-box;
  position: relative;
  max-width: 690rpx;
  margin: 0 auto;
  padding: 0 44rpx;
  text-align: center;
}

.picker__kicker,
.picker__title,
.picker__description,
.picker__shake-hint {
  display: block;
}

.picker__kicker {
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.picker__title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  font-family: var(--font-display);
  color: #fffefb;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.28;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.picker__title--book {
  font-size: 44rpx;
}

.picker__description {
  margin-top: 14rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.68);
  font-size: 26rpx;
  line-height: 1.55;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker__primary,
.picker__secondary {
  box-sizing: border-box;
  min-width: 280rpx;
  height: 92rpx;
  margin: 30rpx auto 0;
  padding: 0 34rpx;
  border: 0;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.picker__primary {
  color: #243c30;
  background: #fffefb;
  box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, 0.25);
}

.picker__primary--disabled {
  color: rgba(36, 60, 48, 0.46);
  background: rgba(255, 254, 251, 0.68);
}

.picker__secondary {
  color: #fffefb;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
}

.picker__primary::after,
.picker__secondary::after {
  border: 0;
}

.picker__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  gap: 18rpx;
}

.picker__actions .picker__primary,
.picker__actions .picker__secondary {
  min-width: 0;
  margin: 0;
}

.picker__shake-hint {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
}

@keyframes focus-settle {
  0% { transform: scale(0.92); opacity: 0.55; }
  72% { transform: scale(1.035); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes picker-pulse {
  0%, 100% { opacity: 0.48; }
  50% { opacity: 0.72; }
}

@media (max-width: 327px) {
  .picker__deck {
    height: 610rpx;
  }

  .picker__swiper {
    height: 566rpx;
  }

  .picker__title {
    font-size: 42rpx;
  }

  .picker__content {
    padding-right: 34rpx;
    padding-left: 34rpx;
  }
}

@media (max-height: 650px) {
  .picker__deck {
    height: 540rpx;
  }

  .picker__swiper {
    height: 500rpx;
  }

  .picker__primary,
  .picker__secondary,
  .picker__actions {
    margin-top: 22rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .picker--result .picker__slide-card--active,
  .picker__skeleton-card {
    animation: none;
  }
}
