.daily {
  display: flex;
  box-sizing: border-box;
  position: relative;
  align-items: stretch;
  min-height: 288rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(175, 165, 150, 0.72);
  border-radius: var(--radius-large);
  background: linear-gradient(135deg, var(--color-surface-primary), var(--color-accent-terracotta-soft));
  box-shadow: var(--shadow-card);
}

.daily::before {
  position: absolute;
  top: -60rpx;
  right: -42rpx;
  width: 210rpx;
  height: 210rpx;
  border: 1rpx solid rgba(201, 110, 80, 0.22);
  border-radius: 50%;
  content: "";
}

.daily__copy {
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.daily__kicker,
.daily__title,
.daily__author {
  display: block;
}

.daily__kicker {
  color: var(--color-accent-terracotta);
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.daily__title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.daily__author {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily__actions {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-top: 22rpx;
  gap: 10rpx;
}

.daily__primary,
.daily__secondary {
  height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.daily__primary {
  color: #fff;
  background: var(--color-brand-forest);
}

.daily__secondary {
  color: var(--color-brand-forest);
  background: rgba(255, 254, 251, 0.74);
}

.daily__primary::after,
.daily__secondary::after {
  border: 0;
}

.daily__wait {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.daily__cover {
  z-index: 1;
  flex: 0 0 126rpx;
  align-self: center;
  width: 126rpx;
  transform: rotate(2deg);
  transform-origin: center;
  transition: transform 180ms ease-out, opacity 160ms ease-in-out;
}

.daily__cover--rolling {
  animation: daily-book-shuffle 360ms ease-in-out infinite;
}

.daily__placeholder {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  aspect-ratio: 3 / 4;
  border: 1rpx solid rgba(175, 165, 150, 0.86);
  border-radius: var(--radius-medium);
  color: var(--color-brand-forest);
  background: var(--color-surface-cover);
  box-shadow: var(--shadow-cover);
}

.daily__placeholder text {
  font-family: var(--font-display);
  font-size: 52rpx;
}

.daily__placeholder view {
  width: 32rpx;
  height: 4rpx;
  margin-top: 22rpx;
  background: var(--color-accent-terracotta);
}

@keyframes daily-book-shuffle {
  0%, 100% { transform: translateX(0) rotate(2deg); }
  35% { transform: translateX(-8rpx) rotate(-3deg); }
  70% { transform: translateX(8rpx) rotate(4deg); }
}

@media (max-width: 327px) {
  .daily {
    min-height: 276rpx;
    padding: 24rpx;
  }

  .daily__cover {
    flex-basis: 108rpx;
    width: 108rpx;
  }

  .daily__title {
    font-size: 27rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .daily__cover--rolling {
    animation: none;
    opacity: 0.62;
  }
}
