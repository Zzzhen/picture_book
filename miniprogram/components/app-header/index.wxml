<view
  class="header {{transparent ? 'header--transparent' : ''}} {{variant ? 'header--' + variant : ''}}"
  style="padding-top: {{statusHeight}}px;"
>
  <view class="header__bar" style="height: {{navigationHeight}}px;">
    <button
      wx:if="{{back}}"
      class="header__back"
      aria-label="返回"
      bindtap="onBack"
    >
      <text class="header__back-icon">‹</text>
    </button>
    <view wx:else class="header__spacer"></view>
    <text class="header__title">{{title}}</text>
    <view class="header__action"><slot name="action"></slot></view>
  </view>
</view>
