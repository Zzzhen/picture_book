<view
  class="header {{transparent ? 'header--transparent' : ''}}"
  style="padding-top: {{statusHeight}}px;"
>
  <view class="header__bar" style="height: {{navigationHeight}}px; padding-right: {{rightInset}}px;">
    <button
      wx:if="{{back}}"
      class="header__back"
      aria-label="返回"
      bindtap="onBack"
    >
      <text class="header__back-icon">‹</text>
    </button>
    <view wx:else class="header__spacer"></view>
    <text class="header__title">{{title}}</text>
    <slot name="action"></slot>
  </view>
</view>
