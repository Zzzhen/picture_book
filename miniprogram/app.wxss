@import "./styles/tokens.wxss";
@import "./styles/typography.wxss";
@import "./styles/animations.wxss";

page {
  min-height: 100%;
  background: linear-gradient(180deg, #F9F3E8 0%, #FAF5EB 52.9%, #FBF7EF 100%);
  color: var(--color-text-primary);
  font-family: var(--font-body);
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 32rpx calc(132rpx + env(safe-area-inset-bottom));
}
