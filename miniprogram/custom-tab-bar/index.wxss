.tabbar {
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(49, 90, 69, 0.09);
  background: rgba(255, 254, 251, 0.97);
  box-shadow: 0 -10rpx 26rpx rgba(43, 55, 46, 0.06);
}

.tabbar__inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  height: 108rpx;
}

.tabbar__item {
  display: flex;
  flex-direction: column;
  position: relative;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 10rpx 0 8rpx;
  border: 0;
  color: var(--color-text-tertiary, #8a938b);
  background: transparent;
  font-size: 21rpx;
  line-height: 1;
}

.tabbar__item::after {
  border: 0;
}

.tabbar__item--active {
  color: var(--color-forest, #315a45);
  font-weight: 650;
}

.tabbar--library {
  border-top-color: rgba(116, 80, 49, 0.08);
  background: rgba(255, 254, 251, 0.98);
  box-shadow: 0 -8rpx 30rpx rgba(94, 67, 43, 0.06);
}

.tabbar--library .tabbar__item--active {
  color: #963a2f;
}

.tabbar--library .tabbar__item--active::before {
  position: absolute;
  top: 0;
  left: 50%;
  width: 26rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #963a2f;
  content: "";
  transform: translateX(-50%);
}

.tabbar--library .tabbar__item--active .tabbar__icon--library {
  border: 0;
  border-bottom: 3rpx solid currentColor;
  border-radius: 0;
}

.tabbar--library .tabbar__item--active .tabbar__icon--library::before,
.tabbar--library .tabbar__item--active .tabbar__icon--library::after {
  position: absolute;
  top: 4rpx;
  bottom: 3rpx;
  width: 19rpx;
  border: 3rpx solid currentColor;
  border-top-left-radius: 9rpx;
  border-top-right-radius: 9rpx;
  background: rgba(255, 254, 251, 0.98);
  content: "";
}

.tabbar--library .tabbar__item--active .tabbar__icon--library::before {
  left: 1rpx;
  border-right: 1rpx solid currentColor;
  transform: skewY(5deg);
}

.tabbar--library .tabbar__item--active .tabbar__icon--library::after {
  right: 1rpx;
  border-left: 1rpx solid currentColor;
  transform: skewY(-5deg);
}

.tabbar__icon {
  box-sizing: border-box;
  position: relative;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 8rpx;
}

.tabbar__icon--library {
  border: 3rpx solid currentColor;
  border-radius: 4rpx 8rpx 8rpx 4rpx;
}

.tabbar__icon--library::before {
  position: absolute;
  top: -3rpx;
  bottom: -3rpx;
  left: 7rpx;
  border-left: 3rpx solid currentColor;
  content: "";
}

.tabbar__icon--shelf {
  border-bottom: 4rpx solid currentColor;
}

.tabbar__icon--shelf::before,
.tabbar__icon--shelf::after,
.tabbar__icon--shelf .tabbar__icon-detail {
  position: absolute;
  bottom: 4rpx;
  width: 9rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 2rpx 2rpx 0 0;
  content: "";
}

.tabbar__icon--shelf::before { left: 1rpx; }
.tabbar__icon--shelf::after { left: 16rpx; height: 34rpx; }
.tabbar__icon--shelf .tabbar__icon-detail { right: 0; height: 24rpx; }

.tabbar__icon--profile::before {
  position: absolute;
  top: 1rpx;
  left: 12rpx;
  width: 17rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  content: "";
}

.tabbar__icon--profile::after {
  position: absolute;
  right: 3rpx;
  bottom: 1rpx;
  left: 3rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  content: "";
}
