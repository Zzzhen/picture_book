<view class="manual">
  <app-header title="{{isResubmit ? '修改并重提' : '手工录入绘本'}}" back="{{true}}" />
  <view class="manual__content">
    <status-banner wx:if="{{reviewStatus === 'pending'}}" type="info" title="已提交审核" message="预计 1–3 天完成。审核期间，你仍可以在自己的绘本馆中查看这本书。" />
    <status-banner wx:if="{{reviewStatus === 'rejected'}}" type="error" title="审核未通过" message="{{rejectReason || '请根据驳回原因修改信息后重新提交。'}}" />
    <status-banner type="warning" title="请尽量准确填写" message="手工提交的信息会进入审核。若 ISBN 与已有记录冲突，将由管理员决定保留的版本。" />
    <view class="manual__cover">
      <view class="manual__cover-placeholder" bindtap="chooseCover">
        <image wx:if="{{form.coverUrl}}" class="manual__cover-preview" src="{{form.coverUrl}}" mode="aspectFill" />
        <block wx:else>
          <text class="manual__cover-plus">＋</text>
          <text>上传封面</text>
        </block>
      </view>
      <view class="manual__cover-copy">
        <text>清晰的正面封面更容易通过审核</text>
        <text>支持 JPEG、PNG、WebP，上传前会进行内容安全检测</text>
        <text wx:if="{{form.coverUrl}}" class="manual__cover-change">点击封面可以更换</text>
      </view>
    </view>
    <view class="manual__form">
      <text-field label="书名" required="{{true}}" value="{{form.title || ''}}" placeholder="请输入绘本完整书名" error="{{errors.title || ''}}" bind:input="onTitle" />
      <text-field label="作者（可选）" value="{{form.author || ''}}" placeholder="作者、文/图译者可用“/”分隔" error="{{errors.author || ''}}" bind:input="onAuthor" />
      <text-field label="ISBN（可选）" value="{{form.isbn || ''}}" placeholder="没有 ISBN 可以留空" error="{{errors.isbn || ''}}" maxlength="{{20}}" bind:input="onIsbn" />
      <text-field label="出版社（可选）" value="{{form.publisher}}" placeholder="请输入出版社" bind:input="onPublisher" />
    </view>
    <ui-button text="{{reviewStatus === 'pending' ? '保存修改' : (reviewStatus === 'rejected' ? '修改并重新提交' : '提交审核')}}" loading="{{submitting}}" bind:tap="submit" />
    <text class="manual__notice">待审核期间仍可修改；被驳回时会展示具体原因，修改后可重新提交。</text>
  </view>
</view>
