<view class="detail">
  <app-header title="绘本详情" back="{{true}}" transparent="{{true}}" variant="detail">
    <button slot="action" class="detail__more" aria-label="更多操作" bindtap="openActions">
      <image src="/assets/book-detail/more-dots.png" mode="aspectFit" />
    </button>
  </app-header>

  <scroll-view class="detail__scroll" scroll-y="{{true}}">
    <view class="detail__content">
      <status-banner wx:if="{{book.reviewStatus === 'pending'}}" type="info" title="手工信息正在审核" message="通常会在 1–3 天内完成，审核期间仍可在自己的绘本馆查看。" />
      <status-banner wx:if="{{book.reviewStatus === 'rejected'}}" type="error" title="手工信息需要修改" message="{{book.rejectReason || '管理员已退回，请补充或修正后重新提交。'}}" action-text="修改重提" bind:action="editManual" />

      <view class="detail__hero">
        <book-cover class="detail__cover" size="large" src="{{book.coverUrl || ''}}" title="{{book.title || ''}}" status="{{book.reviewStatus || ''}}" />
        <view class="detail__hero-copy">
          <text class="detail__title">{{book.title || '未命名绘本'}}</text>
          <text class="detail__author">{{book.author || '作者待补充'}}</text>
          <text class="detail__meta">{{book.publisher || '出版社待补充'}}</text>
          <text class="detail__isbn">ISBN {{book.isbn13 || '无 ISBN'}}</text>
          <text wx:if="{{book.categoryLabel}}" class="detail__shelf-tag">{{book.categoryLabel}}</text>
        </view>
      </view>

      <view class="detail__section detail__preference-card">
        <text class="detail__section-title">孩子的喜好</text>
        <preference-picker class="detail__preference-picker" value="{{book.preference || ''}}" bind:change="onPreference" />
      </view>

      <view class="detail__section detail__management">
        <view class="detail__management-row detail__row">
          <view>
            <text class="detail__section-title">馆藏数量</text>
            <text class="detail__section-note">家里实际拥有的册数</text>
          </view>
          <quantity-stepper class="detail__quantity-stepper" value="{{book.quantity || 1}}" bind:change="onQuantity" />
        </view>

        <view class="detail__divider"></view>

        <view class="detail__management-row detail__shelf-row">
          <view>
            <text class="detail__section-title">所在书架</text>
            <view wx:if="{{book.shelves && book.shelves.length}}" class="detail__chips">
              <text wx:for="{{book.shelves}}" wx:key="_id" class="detail__chip">{{item.name}}</text>
            </view>
            <text wx:else class="detail__section-note">还没有加入书架</text>
          </view>
          <text class="detail__link" bindtap="chooseShelves">调整 <text class="detail__link-arrow">›</text></text>
        </view>

        <view class="detail__divider"></view>

        <view class="detail__note-row">
          <text-field variant="detail" label="家庭备注" type="textarea" value="{{book.note || ''}}" placeholder="记录孩子喜欢的段落、共读感受或借阅去向" maxlength="{{500}}" bind:input="onNote" />
        </view>
      </view>

      <view class="detail__facts">
        <text class="detail__facts-title">图书信息</text>
        <view class="detail__facts-grid">
          <view class="detail__fact"><text>加入时间</text><text>{{book.createdAtText || '—'}}</text></view>
          <view class="detail__fact"><text>装帧</text><text>{{book.binding || '—'}}</text></view>
          <view class="detail__fact"><text>出版时间</text><text>{{book.publishDate || '—'}}</text></view>
          <view class="detail__fact"><text>价格</text><text>{{book.priceText || '—'}}</text></view>
          <view class="detail__fact"><text>页数</text><text>{{book.pageCount || '—'}}</text></view>
        </view>
        <image class="detail__branch" src="/assets/book-detail/branch-watercolor.png" mode="aspectFit" />
      </view>
    </view>
  </scroll-view>

  <view class="detail__actions">
    <ui-button type="danger" size="detail-primary" text="保存修改" loading="{{saving}}" disabled="{{saving}}" bind:tap="saveBook" />
    <ui-button type="danger-secondary" size="detail-secondary" text="从绘本馆删除" bind:tap="askDelete" />
    <image class="detail__bear" src="/assets/book-detail/bear-watercolor.png" mode="aspectFit" />
  </view>

  <confirm-dialog visible="{{deleteVisible}}" loading="{{deleting}}" danger="{{true}}" title="删除这本绘本？" message="会同时从所有书架移除，家庭备注也会删除。此操作无法撤销。" confirm-text="确认删除" bind:confirm="deleteBook" bind:cancel="closeDelete" />
</view>
