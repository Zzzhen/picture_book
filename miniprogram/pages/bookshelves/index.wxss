page {
  background: var(--color-background-paper);
}

.shelves {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.shelves__intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx 36rpx 26rpx;
}

.shelves__intro-copy {
  flex: 1;
  min-width: 0;
}

.shelves__title,
.shelves__copy {
  display: block;
}

.shelves__title {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.shelves__copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.shelves__create {
  flex: 0 0 auto;
  height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--radius-pill);
  color: #fff;
  background: var(--color-brand-forest);
  box-shadow: var(--shadow-card);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.shelves__create text {
  margin-right: 7rpx;
  font-size: 28rpx;
}

.shelves__create::after {
  border: 0;
}

.shelves__body {
  padding: 16rpx 32rpx 40rpx;
}

.shelves__list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

@media (max-width: 327px) {
  .shelves__intro {
    align-items: stretch;
    flex-direction: column;
  }

  .shelves__create {
    align-self: flex-start;
  }
}
