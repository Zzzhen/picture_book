page {
  background: #faf4ea;
}

.profile {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  color: #3b2a1d;
  background-color: #faf4ea;
  background-image: url("/assets/library-home/paper-texture.png");
  background-position: center top;
  background-size: 430rpx auto;
}

.profile__header {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  background: rgba(250, 244, 234, 0.86);
}

.profile__header-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.profile__header-spacer {
  flex: 1;
}

.profile__page-title {
  flex: 0 0 auto;
  color: #3b2a1d;
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.profile__more {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  width: auto;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  color: #4a3523;
  background: transparent;
}

.profile__more::after,
.profile__edit::after,
.profile__feature-card::after,
.profile__menu button::after {
  border: 0;
}

.profile__more-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
}

.profile__content {
  padding: 0 52rpx 54rpx;
}

.profile__identity {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 0 28rpx;
}

.profile__avatar-image {
  display: block;
  flex: 0 0 210rpx;
  width: 210rpx;
  height: 210rpx;
}

.profile__identity-copy {
  flex: 1;
  min-width: 0;
}

.profile__name,
.profile__meta {
  display: block;
}

.profile__name {
  color: #3b2a1d;
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.profile__meta {
  margin-top: 8rpx;
  color: #897b6b;
  font-family: var(--font-display);
  font-size: 30rpx;
  line-height: 1.5;
}

.profile__edit {
  position: absolute;
  top: 64rpx;
  right: 0;
  height: 66rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 2rpx solid #a7372c;
  border-radius: 999rpx;
  color: #a7372c;
  background: rgba(255, 251, 243, 0.22);
  font-family: var(--font-display);
  font-size: 28rpx;
  line-height: 62rpx;
}

.profile__summary {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr 1rpx 1fr 1rpx 1fr;
  align-items: center;
  min-height: 220rpx;
  padding: 18rpx 12rpx;
  border: 2rpx solid rgba(193, 148, 84, 0.28);
  border-radius: 30rpx;
  background: rgba(255, 251, 243, 0.44);
  box-shadow: 0 12rpx 22rpx rgba(139, 92, 43, 0.08);
}

.profile__summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.profile__summary-item image {
  display: block;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 6rpx;
}

.profile__summary-value,
.profile__summary-label {
  display: block;
}

.profile__summary-value {
  color: #3f5137;
  font-family: var(--font-display);
  font-size: 48rpx;
  line-height: 1;
}

.profile__summary-item:nth-child(3) .profile__summary-value { color: #93442d; }
.profile__summary-item:nth-child(5) .profile__summary-value { color: #a47525; }
.profile__summary-item:nth-child(7) .profile__summary-value { color: #93442d; }

.profile__summary-label {
  margin-top: 10rpx;
  color: #594a3b;
  font-family: var(--font-display);
  font-size: 26rpx;
  white-space: nowrap;
}

.profile__summary-divider {
  width: 1rpx;
  height: 110rpx;
  background: rgba(174, 139, 91, 0.34);
}

.profile > status-banner {
  display: block;
  margin-top: 22rpx;
}

.profile__feature-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 46rpx;
}

.profile__feature-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  height: 174rpx;
  margin: 0;
  padding: 0 14rpx 0 0;
  overflow: hidden;
  border: 2rpx solid rgba(134, 139, 91, 0.28);
  border-radius: 26rpx;
  color: #435439;
  background: rgba(229, 234, 199, 0.6);
  text-align: left;
}

.profile__feature-card--report,
.profile__report-card {
  border-color: rgba(207, 155, 57, 0.32);
  color: #815219;
  background: rgba(252, 220, 147, 0.62);
}

.profile__feature-card image {
  display: block;
  flex: 0 0 180rpx;
  height: 110rpx;
}

.profile__feature-card > text {
  flex: 1;
  min-width: 0;
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.profile__feature-arrow {
  display: block;
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 52rpx;
}

.profile__menu {
  overflow: hidden;
  margin-top: 34rpx;
  border: 2rpx solid rgba(193, 148, 84, 0.22);
  border-radius: 26rpx;
  background: rgba(255, 251, 243, 0.52);
}

.profile__menu--account {
  margin-top: 28rpx;
}

.profile__menu button {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  height: 106rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-bottom: 2rpx solid rgba(193, 148, 84, 0.18);
  border-radius: 0;
  color: #3f3428;
  background: transparent;
  font-family: var(--font-display);
  font-size: 30rpx;
  text-align: left;
}

.profile__menu button:last-child {
  border-bottom: 0;
}

.profile__menu button image {
  display: block;
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  margin-right: 26rpx;
}

.profile__menu button text:nth-child(2) {
  flex: 1;
}

.profile__row-arrow {
  display: block;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 54rpx;
}

.profile__menu .profile__danger {
  color: #a7372c;
}

.profile__version {
  display: block;
  margin-top: 30rpx;
  color: #9a8b78;
  font-size: 20rpx;
  text-align: center;
}

@media (max-width: 327px) {
  .profile__content {
    padding-right: 30rpx;
    padding-left: 30rpx;
  }

  .profile__identity {
    gap: 10rpx;
  }

  .profile__avatar-image {
    flex-basis: 176rpx;
    width: 176rpx;
    height: 176rpx;
  }

  .profile__name { font-size: 36rpx; }
  .profile__feature-row { gap: 12rpx; }
  .profile__feature-card > text { font-size: 26rpx; }
  .profile__feature-card image { flex-basis: 144rpx; width: 144rpx; }
}
