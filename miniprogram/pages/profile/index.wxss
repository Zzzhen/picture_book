page {
  background: var(--color-background-paper);
}

.profile {
  min-height: 100vh;
  padding: 0 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.profile__identity {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 6rpx 28rpx;
}

.profile__avatar {
  display: flex;
  flex: 0 0 98rpx;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 98rpx;
  border-radius: 34rpx;
  font-family: var(--font-display);
  color: var(--color-brand-forest);
  background: var(--color-brand-forest-soft);
  font-size: 42rpx;
  font-weight: 700;
}

.profile__identity-copy {
  flex: 1;
}

.profile__name,
.profile__meta,
.profile__section-title,
.profile__hint {
  display: block;
}

.profile__name {
  font-family: var(--font-display);
  font-size: 35rpx;
  font-weight: 700;
}

.profile__meta {
  margin-top: 9rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.profile__edit {
  flex: 0 0 auto;
  height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-pill);
  color: var(--color-brand-forest);
  background: var(--color-surface-primary);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 86rpx;
}

.profile__edit::after {
  border: 0;
}

.profile__summary {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr 1rpx 1fr 1rpx 1fr;
  align-items: center;
  min-height: 126rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-large);
  background: var(--color-surface-primary);
  box-shadow: var(--shadow-card);
}

.profile__summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.profile__summary-value,
.profile__summary-label {
  display: block;
}

.profile__summary-value {
  font-family: var(--font-display);
  color: var(--color-brand-forest);
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1;
}

.profile__summary-label {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  white-space: nowrap;
}

.profile__summary-divider {
  width: 1rpx;
  height: 54rpx;
  background: var(--color-border-default);
}

.profile > status-banner {
  display: block;
  margin-top: 22rpx;
}

.profile__group-title {
  display: block;
  margin: 30rpx 0 12rpx 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.profile__menu {
  overflow: hidden;
  margin-top: 0;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-large);
  background: var(--color-surface-primary);
}

.profile__menu button {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 94rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-bottom: 1rpx solid var(--color-border-default);
  border-radius: 0;
  color: var(--color-text-primary);
  background: transparent;
  font-size: 25rpx;
  text-align: left;
}

.profile__menu button::after {
  border: 0;
}

.profile__menu button:last-child {
  border-bottom: 0;
}

.profile__menu button text:last-child {
  color: var(--color-text-muted);
  font-size: 34rpx;
}

.profile__menu .profile__danger {
  color: var(--color-state-danger);
}

.profile__version {
  display: block;
  margin-top: 28rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  text-align: center;
}

@media (max-width: 327px) {
  .profile__identity {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .profile__edit {
    margin-left: 120rpx;
  }

  .profile__summary {
    grid-template-columns: repeat(2, 1fr);
    gap: 24rpx 12rpx;
    padding: 24rpx 18rpx;
  }

  .profile__summary-divider {
    display: none;
  }
}
