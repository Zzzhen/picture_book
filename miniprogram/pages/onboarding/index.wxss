page {
  background: var(--color-background-paper);
}

.onboarding {
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.onboarding__progress {
  overflow: hidden;
  height: 5rpx;
  background: var(--color-border-default);
}

.onboarding__progress-fill {
  height: 100%;
  transition: width 200ms ease;
  background: var(--color-brand-forest);
}

.onboarding__content {
  padding: 52rpx 42rpx 20rpx;
}

.onboarding__intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 44rpx;
}

.onboarding__eyebrow {
  margin-top: 28rpx;
  color: var(--color-accent-terracotta);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.onboarding__title {
  margin-top: 12rpx;
  font-family: var(--font-display);
  font-size: 45rpx;
  font-weight: 700;
}

.onboarding__description {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.onboarding__form {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

.onboarding__label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-text-primary);
  font-size: 26rpx;
  font-weight: 650;
}

.onboarding__required,
.onboarding__error {
  color: var(--color-state-danger);
}

.onboarding__error {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.onboarding__gender {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.onboarding__gender-item {
  height: 82rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 2rpx solid var(--color-border-default);
  border-radius: var(--radius-medium);
  color: var(--color-text-secondary);
  background: var(--color-surface-primary);
  font-size: 25rpx;
  line-height: 80rpx;
}

.onboarding__gender-item::after {
  border: 0;
}

.onboarding__gender-item--active {
  border-color: var(--color-brand-forest);
  color: var(--color-brand-forest);
  background: var(--color-brand-forest-soft);
  font-weight: 650;
}

.onboarding__footer {
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx 42rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-default);
  background: rgba(247, 243, 234, 0.97);
}

.onboarding__privacy {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  text-align: center;
}
