<view class="shelf-edit">
  <app-header title="{{isNew ? '新建书架' : '编辑书架'}}" back="{{true}}"></app-header>
  <view class="shelf-edit__form">
    <text-field label="书架名称" required="{{true}}" value="{{form.name}}" placeholder="例如：睡前共读" maxlength="{{20}}" error="{{errors.name}}" bind:input="onName" />
    <text-field label="说明（可选）" type="textarea" value="{{form.description}}" placeholder="记录这个书架的用途" maxlength="{{100}}" bind:input="onDescription" />
  </view>
  <view class="shelf-edit__books">
    <view class="shelf-edit__section-head">
      <view><text class="shelf-edit__title">选择绘本</text><text class="shelf-edit__count">已选 {{selectedCount || 0}} 本</text></view>
      <text class="shelf-edit__select-all" bindtap="toggleAll">{{allSelected ? '取消全选' : '全选'}}</text>
    </view>
    <search-field value="{{keyword}}" placeholder="搜索馆藏绘本" bind:input="onSearch" />
    <empty-state wx:if="{{state === 'search-empty'}}" type="search" title="没有匹配的馆藏" description="换个书名或作者试试。" />
    <view wx:else class="shelf-edit__list">
      <block wx:for="{{displayBooks}}" wx:key="_id">
        <book-list-item book="{{item}}" manage="{{true}}" selected="{{item.selected}}" bind:select="toggleBook" />
      </block>
    </view>
  </view>
  <view class="shelf-edit__actions">
    <ui-button text="保存" loading="{{saving}}" disabled="{{saving}}" bind:tap="save" />
    <ui-button wx:if="{{!isNew}}" type="danger" text="删除这个书架" bind:tap="askDelete" />
  </view>
  <confirm-dialog visible="{{deleteVisible}}" danger="{{true}}" title="删除这个书架？" message="绘本不会从家庭绘本馆删除，只会移除这个分组。" confirm-text="确认删除" bind:confirm="deleteShelf" bind:cancel="closeDelete" />
</view>
