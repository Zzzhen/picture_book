<view class="shelf-edit">
  <app-header title="{{isNew ? '新建书架' : '编辑书架'}}" back="{{true}}"></app-header>
  <view class="shelf-edit__intro">
    <text class="shelf-edit__eyebrow">书架资料</text>
    <text class="shelf-edit__hint">用简短的名称和说明，记下这个书架的共读主题。</text>
  </view>
  <view class="shelf-edit__form">
    <text-field label="书架名称" required="{{true}}" value="{{form.name}}" placeholder="例如：睡前共读" error="{{errors.name}}" bind:input="onName" />
    <text-field label="说明（可选）" type="textarea" value="{{form.description}}" placeholder="记录这个书架适合什么时间或主题" bind:input="onDescription" />
  </view>
  <view class="shelf-edit__actions">
    <ui-button text="保存" loading="{{saving}}" disabled="{{saving || deleting}}" bind:tap="save" />
    <ui-button wx:if="{{!isNew}}" type="danger" text="删除这个书架" loading="{{deleting}}" disabled="{{saving || deleting}}" bind:tap="askDelete" />
  </view>
  <confirm-dialog visible="{{deleteVisible}}" danger="{{true}}" title="删除这个书架？" message="书架会被删除，绘本仍保留在你的绘本馆中。" confirm-text="删除" bind:cancel="closeDelete" bind:confirm="deleteShelf" />
</view>
