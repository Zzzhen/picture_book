page {
  background: var(--color-background-paper);
}

.shelf-edit {
  min-height: 100vh;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.shelf-edit__intro {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx 36rpx 8rpx;
}

.shelf-edit__eyebrow {
  color: var(--color-brand-forest);
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
}

.shelf-edit__hint {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.shelf-edit__form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 28rpx 36rpx 40rpx;
}

.shelf-edit__actions {
  display: flex;
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  flex-direction: column;
  padding: 14rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-default);
  background: var(--color-surface-primary);
  box-shadow: 0 -8rpx 24rpx rgba(44, 50, 42, 0.08);
}

.shelf-edit__actions ui-button {
  display: block;
  margin: 10rpx 0 0;
}
