page {
  background: var(--color-background-paper);
}

.shelf-edit {
  min-height: 100vh;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.shelf-edit__select-all {
  color: var(--color-brand-forest);
  font-size: 24rpx;
  font-weight: 650;
}

.shelf-edit__form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 34rpx 36rpx;
  border-bottom: 1rpx solid var(--color-border-default);
}

.shelf-edit__books {
  padding: 32rpx 34rpx;
}

.shelf-edit__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.shelf-edit__title,
.shelf-edit__count {
  display: block;
}

.shelf-edit__title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 700;
}

.shelf-edit__count {
  margin-top: 7rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.shelf-edit__list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--color-border-default);
}

.shelf-edit__actions {
  display: flex;
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  flex-direction: column;
  padding: 14rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-default);
  background: var(--color-surface-primary);
  box-shadow: 0 -8rpx 24rpx rgba(44, 50, 42, 0.08);
}

.shelf-edit__actions ui-button {
  display: block;
  margin: 10rpx 0 0;
}
