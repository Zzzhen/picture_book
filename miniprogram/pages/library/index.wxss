page {
  background: var(--color-background-paper);
}

.library {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.library__manage {
  color: var(--color-brand-forest);
  font-size: 25rpx;
  font-weight: 650;
}

.library__top {
  padding: 24rpx 32rpx 18rpx;
}

.library__identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.library__daily-entry {
  display: flex;
  box-sizing: border-box;
  position: relative;
  align-items: center;
  width: 100%;
  min-height: 176rpx;
  margin: 0 0 28rpx;
  padding: 26rpx 28rpx;
  overflow: hidden;
  border: 0;
  border-radius: var(--radius-large);
  color: #fff;
  background: linear-gradient(135deg, #315a45 0%, #254637 100%);
  box-shadow: var(--shadow-floating);
  text-align: left;
}

.library__daily-entry::before {
  position: absolute;
  top: -72rpx;
  right: -44rpx;
  width: 220rpx;
  height: 220rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  content: "";
}

.library__daily-entry::after {
  border: 0;
}

.library__daily-icon {
  position: relative;
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 108rpx;
  margin-right: 24rpx;
}

.library__daily-book {
  position: absolute;
  bottom: 12rpx;
  width: 42rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
}

.library__daily-book--left {
  left: 8rpx;
  transform: rotate(-10deg);
}

.library__daily-book--middle {
  bottom: 18rpx;
  left: 34rpx;
  height: 86rpx;
  border-color: #efb49f;
  background: rgba(201, 110, 80, 0.42);
}

.library__daily-book--right {
  right: 6rpx;
  transform: rotate(9deg);
}

.library__daily-copy {
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.library__daily-kicker,
.library__daily-title,
.library__daily-meta {
  display: block;
}

.library__daily-kicker {
  color: #efb49f;
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.library__daily-title {
  margin-top: 5rpx;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.library__daily-meta {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.library__daily-arrow {
  z-index: 1;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 48rpx;
  font-weight: 300;
}

.library__eyebrow,
.library__count {
  display: block;
}

.library__eyebrow {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
}

.library__count {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.library__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.library__filters {
  display: flex;
  gap: 12rpx;
}

.library__filter {
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  background: var(--color-surface-primary);
  font-size: 22rpx;
  line-height: 54rpx;
}

.library__filter::after {
  border: 0;
}

.library__filter--active {
  border-color: var(--color-brand-forest);
  color: var(--color-brand-forest);
  background: var(--color-brand-forest-soft);
}

.library > status-banner {
  display: block;
  margin: 0 32rpx 18rpx;
}

.library__body {
  padding: 18rpx 32rpx 40rpx;
}

.library__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 38rpx 22rpx;
}

.library__list {
  border-top: 1rpx solid var(--color-border-default);
}

.library__paging {
  display: block;
  padding: 42rpx 0 14rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  text-align: center;
}

.library__add {
  display: flex;
  z-index: 20;
  position: fixed;
  right: 30rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  align-items: center;
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: var(--radius-pill);
  color: #fff;
  background: var(--color-brand-forest);
  box-shadow: var(--shadow-floating);
  font-size: 34rpx;
  line-height: 76rpx;
}

.library__add::after {
  border: 0;
}

.library__add-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.library__selection {
  display: flex;
  z-index: 30;
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-default);
  background: var(--color-surface-primary);
  font-size: 25rpx;
}

@media (max-width: 327px) {
  .library__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34rpx 26rpx;
  }

  .library__identity bookplate-mark {
    display: none;
  }

  .library__toolbar {
    align-items: flex-start;
    gap: 12rpx;
  }
}
