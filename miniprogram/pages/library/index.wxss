page {
  background:
    radial-gradient(
      ellipse at 15% 8%,
      rgba(255, 255, 255, 0.65) 0%,
      transparent 42%
    ),
    radial-gradient(
      ellipse at 85% 45%,
      rgba(235, 213, 180, 0.16) 0%,
      transparent 52%
    ),
    linear-gradient(
      180deg,
      #fbf7ef 0%,
      #faf3e8 100%
    );
}

.library {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
  color: #412c1a;
}

.library__header {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 0 38rpx 18rpx;
}

.library__header-spacer {
  width: 88rpx;
}

.library__page-title {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  text-align: center;
}

.library__avatar {
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  margin: 0 0 0 auto;
  padding: 0;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #ead9bc;
  box-shadow: 0 4rpx 12rpx rgba(94, 67, 43, 0.16);
  line-height: 1;
}

.library__avatar::after,
.library__hero::after,
.library__shake::after,
.library__manage::after,
.library__filter::after,
.library__search-clear::after,
.library__add::after {
  border: 0;
}

.library__avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.library__home {
  padding: 8rpx 38rpx 42rpx;
}

.library__home > status-banner {
  display: block;
  margin-bottom: 18rpx;
}

.library__hero {
  display: block;
  box-sizing: border-box;
  position: relative;
  width: 100%;
  height: 334rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  color: #412c1a;
  text-align: left;
  background: #f5e8d3;
  border: 2rpx solid rgba(190, 145, 82, 0.2);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(115, 77, 35, 0.08);
}

.library__hero-copy {
  display: flex;
  z-index: 2;
  position: absolute;
  top: 76rpx;
  left: 38rpx;
  flex-direction: column;
  align-items: flex-start;
  max-width: 370rpx;
}

.library__hero-title,
.library__hero-question {
  display: block;
  font-family: var(--font-display);
  font-weight: 500;
  line-height: 1.32;
  white-space: nowrap;
}

.library__hero-title {
  max-width: 390rpx;
  overflow: hidden;
  font-size: 43rpx;
  text-overflow: ellipsis;
  font-weight: 600;
}

.library__hero-question {
  margin-top: 18rpx;
  font-size: 40rpx;
}

.library__hero-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-top: 28rpx;
  border-radius: 50%;
  color: #fdfbf9;
}

.library__hero-art {
  position: absolute;
  right: 0rpx;
  bottom: 0rpx;
  width: 300rpx;
  height: 300rpx;
}

.library__search {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  height: 84rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  border: 1rpx solid rgba(112, 91, 70, 0.07);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(92, 64, 38, 0.08);
  background: rgba(255, 255, 255, 0.82);
}

.library__search:focus-within {
  border-color: rgba(150, 58, 47, 0.36);
}

.library__search-icon {
  box-sizing: border-box;
  position: relative;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-right: 22rpx;
  border: 4rpx solid #77777b;
  border-radius: 50%;
}

.library__search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #77777b;
  content: "";
  transform: rotate(45deg);
}

.library__search-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  color: #412c1a;
  font-size: 29rpx;
  line-height: 70rpx;
}

.library__search-placeholder {
  color: #807e81;
}

.library__search-clear {
  width: 56rpx;
  height: 56rpx;
  margin: 0 -10rpx 0 8rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #807e81;
  background: transparent;
  font-size: 34rpx;
  line-height: 56rpx;
}

.library__shake {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  height: 132rpx;
  margin: 26rpx 0 0;
  padding: 12rpx 28rpx 12rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(183, 124, 58, 0.22);
  border-radius: 24rpx;
  color: #412c1a;
  background: rgba(255, 246, 231, 0.7);
  text-align: left;
}

.library__shake-art {
  flex: 0 0 138rpx;
  width: 138rpx;
  height: 108rpx;
  margin-right: 18rpx;
}

.library__shake-copy {
  flex: 1;
  min-width: 0;
}

.library__shake-title,
.library__shake-caption {
  display: block;
}

.library__shake-title {
  color: #963a2f;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.library__shake-caption {
  margin-top: 4rpx;
  font-size: 27rpx;
}

.library__shake-arrow {
  margin-left: 16rpx;
  color: #963a2f;
  font-family: Arial, sans-serif;
  font-size: 48rpx;
  font-weight: 300;
}

.library__overview-state {
  min-height: 500rpx;
  padding: 34rpx 0 20rpx;
}

.library__full {
  padding: 8rpx 32rpx 42rpx;
}

.library__full-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.library__full-heading {
  flex: 1;
  min-width: 0;
}

.library__full-title,
.library__full-count {
  display: block;
}

.library__full-title {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.library__full-count {
  margin-top: 7rpx;
  color: #76695c;
  font-size: 23rpx;
}

.library__manage {
  min-width: 88rpx;
  height: 60rpx;
  margin: 0 -8rpx 0 0;
  padding: 0 8rpx;
  border: 0;
  color: #963a2f;
  background: transparent;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 60rpx;
}

.library__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.library__filters {
  display: flex;
  gap: 12rpx;
}

.library__filter {
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8cdbf;
  border-radius: 30rpx;
  color: #6f6459;
  background: rgba(255, 254, 251, 0.88);
  font-size: 22rpx;
  line-height: 54rpx;
}

.library__filter--active {
  border-color: #963a2f;
  color: #963a2f;
  background: #f4ded8;
}

.library__full > status-banner {
  display: block;
  margin-bottom: 18rpx;
}

.library__body {
  padding: 8rpx 0 40rpx;
}

.library__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 38rpx 22rpx;
}

.library__list {
  border-top: 1rpx solid rgba(111, 86, 62, 0.16);
}

.library__paging {
  display: block;
  padding: 42rpx 0 14rpx;
  color: #897c70;
  font-size: 22rpx;
  text-align: center;
}

.library__add {
  display: flex;
  z-index: 20;
  position: fixed;
  right: 30rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  align-items: center;
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 40rpx;
  color: #fdfbf9;
  background: #963a2f;
  box-shadow: 0 12rpx 26rpx rgba(123, 48, 40, 0.22);
  font-size: 34rpx;
  line-height: 76rpx;
}

.library__add-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.library__selection {
  display: flex;
  z-index: 30;
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(111, 86, 62, 0.16);
  background: #fdfbf9;
  font-size: 25rpx;
}

@media (max-width: 327px) {
  .library__header {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .library__home {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .library__hero-copy {
    top: 68rpx;
    left: 30rpx;
  }

  .library__hero-title {
    max-width: 330rpx;
    font-size: 38rpx;
  }

  .library__hero-question {
    font-size: 36rpx;
  }

  .library__hero-art {
    right: -38rpx;
    width: 370rpx;
  }

  .library__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34rpx 28rpx;
  }

  .library__toolbar {
    align-items: flex-start;
    gap: 12rpx;
  }
}
