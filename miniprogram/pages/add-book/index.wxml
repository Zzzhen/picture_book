<view class="add-book">
  <app-header title="{{mode === 'continuous' ? '连续扫码' : '录入绘本'}}" back="{{true}}" />
  <view wx:if="{{mode === 'choose'}}" class="add-book__content">
    <view class="add-book__heading">
      <text class="add-book__title">把绘本放进家庭书库</text>
      <text class="add-book__description">优先扫码识别 ISBN；连续整理一批绘本时，可开启连续扫码。</text>
    </view>
    <button class="add-book__method" data-mode="single" bindtap="chooseMode">
      <view class="add-book__method-icon add-book__method-icon--scan"><view></view></view>
      <view class="add-book__method-body">
        <text class="add-book__method-title">扫描一本</text>
        <text class="add-book__method-copy">扫描封底条码，确认后加入绘本馆</text>
      </view>
      <text class="add-book__arrow">›</text>
    </button>
    <button class="add-book__method" data-mode="continuous" bindtap="chooseMode">
      <view class="add-book__method-icon add-book__method-icon--stack"><view></view></view>
      <view class="add-book__method-body">
        <text class="add-book__method-title">连续扫码</text>
        <text class="add-book__method-copy">扫码成功后自动继续，结束后统一确认入馆</text>
      </view>
      <text class="add-book__arrow">›</text>
    </button>
    <button class="add-book__method" data-mode="cache-search" bindtap="chooseMode">
      <view class="add-book__method-icon add-book__method-icon--search"><view></view></view>
      <view class="add-book__method-body">
        <text class="add-book__method-title">搜索已查询书库</text>
        <text class="add-book__method-copy">只查曾经成功查询的绘本，不会触发付费接口</text>
      </view>
      <text class="add-book__arrow">›</text>
    </button>
    <view class="add-book__manual">
      <text>条码磨损，或绘本没有 ISBN？</text>
      <text class="add-book__link" bindtap="goManual">手工录入</text>
    </view>
  </view>
  <view wx:elif="{{mode === 'single' || mode === 'isbn'}}" class="add-book__content">
    <view class="add-book__scan-card">
      <view class="add-book__scanner">
        <view class="add-book__corner add-book__corner--tl"></view>
        <view class="add-book__corner add-book__corner--tr"></view>
        <view class="add-book__corner add-book__corner--bl"></view>
        <view class="add-book__corner add-book__corner--br"></view>
        <view class="add-book__barcode"></view>
      </view>
      <text class="add-book__scan-title">对准绘本封底条码</text>
      <text class="add-book__scan-copy">仅识别 ISBN 条码，不会保存相机画面</text>
      <ui-button text="打开相机扫码" bind:tap="scan" />
    </view>
    <view class="add-book__divider"><view></view><text>或输入 ISBN</text><view></view></view>
    <text-field label="ISBN" value="{{isbn}}" placeholder="输入 10 或 13 位 ISBN" error="{{isbnError}}" maxlength="{{20}}" bind:input="onIsbnInput" />
    <ui-button type="secondary" text="查询绘本" loading="{{querying}}" disabled="{{!isbn}}" bind:tap="lookup" />
    <status-banner wx:if="{{state === 'provider-unavailable'}}" type="warning" title="图书信息服务暂时不可用" message="没有产生付费查询，请稍后重试，或选择手工录入。" action-text="手工录入" bind:action="goManual" />
  </view>
  <view wx:elif="{{mode === 'cache-search'}}" class="add-book__content">
    <text class="add-book__title">搜索已查询书库</text>
    <text class="add-book__description">这里只查找曾经成功查询过的绘本，不会触发付费接口。</text>
    <text-field label="书名、作者或 ISBN" value="{{cacheKeyword}}" placeholder="输入关键词" bind:input="onCacheKeyword" />
    <ui-button text="搜索" bind:tap="searchCache" />
    <view wx:if="{{cacheResult}}" class="add-book__result" bindtap="selectCacheResult">
      <book-cover size="small" src="{{cacheResult.coverUrl}}" title="{{cacheResult.title}}" />
      <view><text class="add-book__result-title">{{cacheResult.title}}</text><text class="add-book__result-meta">{{cacheResult.author}}</text></view>
      <text class="add-book__arrow">›</text>
    </view>
    <empty-state wx:if="{{state === 'search-empty'}}" type="search" title="已查询书库中没有结果" description="可以返回扫码或输入 ISBN 发起新查询。" primary-text="输入 ISBN 查询" bind:primary="showIsbn" />
  </view>
  <view wx:elif="{{mode === 'continuous'}}" class="add-book__continuous">
    <view class="add-book__scan-ticket">
      <view>
        <text class="add-book__ticket-label">本轮待确认</text>
        <text class="add-book__ticket-count">{{uniqueCount || 0}} 种 · {{copyCount || 0}} 册</text>
      </view>
      <view class="add-book__ticket-progress">
        <text>{{session.total || 0}}</text>
        <text>/ 100 次</text>
      </view>
    </view>

    <view wx:if="{{scanState === 'opening' || scanState === 'looking_up'}}" class="add-book__scan-pulse">
      <view class="add-book__barcode"></view>
      <text>{{scanState === 'opening' ? '正在打开相机…' : '正在查询绘本信息…'}}</text>
    </view>
    <status-banner wx:if="{{scanState === 'success'}}" type="success" title="扫码成功" message="《{{lastBook.title}}》已加入本轮列表，即将继续扫描。" />
    <status-banner wx:elif="{{scanState === 'paused'}}" type="error" title="这次没有识别成功" message="{{scanError || '请调整距离后重试，也可以跳过这一本。'}}" />
    <status-banner wx:if="{{submitError}}" type="warning" title="还有内容未完成" message="{{submitError}}" />

    <view wx:if="{{scanState === 'paused'}}" class="add-book__paused-actions">
      <ui-button text="重试扫码" bind:tap="retryScan" />
      <view class="add-book__paused-row">
        <button bindtap="goManual">手工录入</button>
        <button bindtap="skip">跳过并继续</button>
        <button bindtap="finishContinuous">结束扫码</button>
      </view>
    </view>

    <view wx:if="{{scanItems.length}}" class="add-book__review">
      <view class="add-book__review-heading">
        <view>
          <text class="add-book__review-title">选择入馆的绘本</text>
          <text class="add-book__review-copy">相同 ISBN 已合并，可在确认前移除。</text>
        </view>
        <text wx:if="{{committedCount}}" class="add-book__commit-progress">已入馆 {{committedCount}} / {{copyCount}}</text>
      </view>
      <view wx:for="{{scanItems}}" wx:key="edition_id" class="add-book__scan-item add-book__scan-item--{{item.status}}">
        <view class="add-book__scan-cover">
          <book-cover size="medium" src="{{item.cover_url}}" title="{{item.title}}" />
        </view>
        <view class="add-book__scan-info">
          <text class="add-book__scan-title">{{item.title}}</text>
          <text class="add-book__scan-meta">{{item.contributors_text || '作者待补充'}}</text>
          <text class="add-book__scan-isbn">ISBN {{item.isbn13}}</text>
          <view class="add-book__scan-status">
            <text class="add-book__copy-badge">本轮 {{item.scan_count}} 册</text>
            <text wx:if="{{item.status === 'submitting'}}">入馆中</text>
            <text wx:elif="{{item.status === 'added'}}" class="add-book__status-success">已入馆</text>
            <text wx:elif="{{item.status === 'failed'}}" class="add-book__status-error">{{item.error_message || '入馆失败'}}</text>
          </view>
        </view>
        <button wx:if="{{scanState === 'ready' && !submissionStarted && !submitting}}" class="add-book__remove" data-id="{{item.edition_id}}" bindtap="removeScanItem" aria-label="从本轮移除 {{item.title}}">×</button>
      </view>
    </view>

    <view wx:else class="add-book__continuous-empty">
      <text class="add-book__continuous-empty-title">还没有待入馆的绘本</text>
      <text>点击开始扫码，识别成功后会自动继续下一本。</text>
    </view>

    <view wx:if="{{scanState === 'ready' && !submissionStarted}}" class="add-book__start-action">
      <ui-button text="开始扫码" bind:tap="startContinuousScan" />
    </view>
    <view wx:if="{{scanState === 'success' || scanState === 'looking_up'}}" class="add-book__stop-action">
      <button bindtap="finishContinuous">结束扫码</button>
    </view>

    <button wx:if="{{scanItems.length && (scanState === 'ready' || submissionStarted)}}" class="add-book__shelf-choice" bindtap="chooseShelf" disabled="{{submitting || shelvesLoading}}">
      <view>
        <text class="add-book__shelf-label">选择书架（可选）</text>
        <text class="add-book__shelf-value">{{selectedShelf ? selectedShelf.name : '不选择则只加入绘本馆'}}</text>
      </view>
      <text class="add-book__shelf-change">{{shelvesLoading ? '加载中…' : selectedShelf ? '更换 ›' : '选择 ›'}}</text>
    </button>

    <view wx:if="{{shelfPickerOpen}}" class="add-book__shelf-mask" bindtap="closeShelfPicker">
      <view class="add-book__shelf-sheet" catchtap="noop">
        <view class="add-book__sheet-heading">
          <view>
            <text class="add-book__sheet-title">选择书架</text>
            <text class="add-book__sheet-copy">可选一个书架，也可以只加入绘本馆。</text>
          </view>
          <button bindtap="closeShelfPicker">完成</button>
        </view>
        <scroll-view scroll-y="{{true}}" class="add-book__shelf-options">
          <button class="add-book__shelf-option {{!selectedShelf ? 'add-book__shelf-option--selected' : ''}}" data-id="" bindtap="selectShelf">
            <view><text>不加入书架</text><text>只加入绘本馆</text></view>
            <text wx:if="{{!selectedShelf}}">✓</text>
          </button>
          <button wx:for="{{shelves}}" wx:key="bookshelf_id" class="add-book__shelf-option {{selectedShelf && selectedShelf.bookshelf_id === item.bookshelf_id ? 'add-book__shelf-option--selected' : ''}}" data-id="{{item.bookshelf_id}}" bindtap="selectShelf">
            <view><text>{{item.name}}</text><text>{{item.book_count || 0}} 本绘本</text></view>
            <text wx:if="{{selectedShelf && selectedShelf.bookshelf_id === item.bookshelf_id}}">✓</text>
          </button>
          <text wx:if="{{!shelves.length}}" class="add-book__shelf-empty">还没有书架，可以先只加入绘本馆。</text>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{scanItems.length && (scanState === 'ready' || submissionStarted)}}" class="add-book__commit-bar">
      <ui-button text="{{submitting ? '正在入馆…' : submitError ? '重试失败项' : '确认入馆（' + copyCount + ' 册）'}}" loading="{{submitting}}" disabled="{{!copyCount}}" bind:tap="confirmBatch" />
    </view>
  </view>
</view>
