page {
  background: var(--color-background-paper);
}

.add-book {
  min-height: 100vh;
}

.add-book__content,
.add-book__continuous {
  padding: 38rpx 38rpx calc(48rpx + env(safe-area-inset-bottom));
}

.add-book__heading {
  margin-bottom: 38rpx;
}

.add-book__title,
.add-book__description,
.add-book__method-title,
.add-book__method-copy {
  display: block;
}

.add-book__title {
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
}

.add-book__description {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.add-book__method {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  min-height: 150rpx;
  margin: 0 0 20rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-large);
  color: var(--color-text-primary);
  background: var(--color-surface-primary);
  box-shadow: var(--shadow-card);
  text-align: left;
}

.add-book__method::after {
  border: 0;
}

.add-book__method-icon {
  display: flex;
  flex: 0 0 82rpx;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  color: var(--color-brand-forest);
  background: var(--color-brand-forest-soft);
}

.add-book__method-icon--scan view {
  width: 42rpx;
  height: 28rpx;
  border-top: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
}

.add-book__method-icon--stack view {
  width: 37rpx;
  height: 47rpx;
  border: 4rpx solid currentColor;
  box-shadow: 10rpx 10rpx 0 -3rpx var(--color-brand-forest-soft), 10rpx 10rpx 0 0 currentColor;
}

.add-book__method-icon--search view {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.add-book__method-icon--search view::after {
  position: absolute;
  right: -16rpx;
  bottom: -10rpx;
  width: 20rpx;
  height: 4rpx;
  transform: rotate(45deg);
  background: currentColor;
  content: "";
}

.add-book__method-body {
  flex: 1;
}

.add-book__method-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
}

.add-book__method-copy {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.add-book__arrow {
  margin-left: 12rpx;
  color: var(--color-text-muted);
  font-size: 42rpx;
}

.add-book__manual {
  margin-top: 38rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.add-book__link {
  margin-left: 10rpx;
  color: var(--color-brand-forest);
  font-weight: 650;
}

.add-book__scan-card {
  padding: 38rpx 32rpx 30rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-large);
  background: var(--color-surface-primary);
  text-align: center;
}

.add-book__scanner {
  position: relative;
  width: 360rpx;
  height: 220rpx;
  margin: 0 auto 28rpx;
  background: var(--color-surface-secondary);
}

.add-book__scanner--continuous {
  width: 520rpx;
  max-width: 100%;
  height: 360rpx;
  margin-top: 24rpx;
}

.add-book__corner {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  border-color: var(--color-brand-forest);
  border-style: solid;
}

.add-book__corner--tl { top: 0; left: 0; border-width: 5rpx 0 0 5rpx; }
.add-book__corner--tr { top: 0; right: 0; border-width: 5rpx 5rpx 0 0; }
.add-book__corner--bl { bottom: 0; left: 0; border-width: 0 0 5rpx 5rpx; }
.add-book__corner--br { right: 0; bottom: 0; border-width: 0 5rpx 5rpx 0; }

.add-book__barcode {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 180rpx;
  height: 64rpx;
  transform: translate(-50%, -50%);
  background: repeating-linear-gradient(90deg, var(--color-text-muted) 0 3rpx, transparent 3rpx 8rpx);
  opacity: 0.38;
}

.add-book__scan-title,
.add-book__scan-copy {
  display: block;
}

.add-book__scan-title {
  font-size: 29rpx;
  font-weight: 650;
}

.add-book__scan-copy {
  margin: 10rpx 0 26rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.add-book__divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 34rpx 0;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.add-book__divider view {
  flex: 1;
  height: 1rpx;
  background: var(--color-border-default);
}

.add-book__content > ui-button,
.add-book__content > status-banner {
  display: block;
  margin-top: 24rpx;
}

.add-book__result {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-medium);
  background: var(--color-surface-primary);
}

.add-book__result > view {
  flex: 1;
}

.add-book__result-title,
.add-book__result-meta {
  display: block;
}

.add-book__result-title {
  font-weight: 650;
}

.add-book__result-meta {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.add-book__continuous {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.add-book__scan-ticket {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  padding: 28rpx 30rpx 26rpx 34rpx;
  border: 1rpx solid var(--color-border-default);
  border-left: 8rpx solid var(--color-accent-terracotta);
  border-radius: 8rpx var(--radius-medium) var(--radius-medium) 8rpx;
  background: var(--color-surface-primary);
  box-shadow: var(--shadow-card);
}

.add-book__scan-ticket::after {
  position: absolute;
  right: 126rpx;
  bottom: 0;
  width: 1rpx;
  height: 100%;
  background: repeating-linear-gradient(to bottom, var(--color-border-default) 0 8rpx, transparent 8rpx 15rpx);
  content: "";
}

.add-book__ticket-label,
.add-book__ticket-count {
  display: block;
}

.add-book__ticket-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.add-book__ticket-count {
  margin-top: 7rpx;
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.add-book__ticket-progress {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: var(--color-text-muted);
  font-size: 20rpx;
}

.add-book__ticket-progress text:first-child {
  color: var(--color-brand-forest);
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
}

.add-book__scan-pulse {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 154rpx;
  margin-top: 24rpx;
  padding-bottom: 20rpx;
  border-radius: var(--radius-medium);
  color: var(--color-text-secondary);
  background: var(--color-brand-forest-soft);
  font-size: 23rpx;
}

.add-book__scan-pulse .add-book__barcode {
  top: 43%;
}

.add-book__continuous > status-banner {
  display: block;
  margin: 24rpx 0 0;
}

.add-book__paused-actions {
  margin-top: 20rpx;
}

.add-book__paused-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.add-book__paused-row button,
.add-book__stop-action button {
  flex: 1;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  background: transparent;
  font-size: 22rpx;
  line-height: 70rpx;
}

.add-book__paused-row button::after,
.add-book__stop-action button::after,
.add-book__remove::after,
.add-book__shelf-choice::after {
  border: 0;
}

.add-book__review {
  margin-top: 34rpx;
}

.add-book__review-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.add-book__review-title,
.add-book__review-copy {
  display: block;
}

.add-book__review-title {
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
}

.add-book__review-copy,
.add-book__commit-progress {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.add-book__commit-progress {
  color: var(--color-brand-forest);
}

.add-book__scan-item {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-medium);
  background: var(--color-surface-primary);
}

.add-book__scan-item--failed {
  border-color: rgba(169, 65, 63, 0.42);
}

.add-book__scan-cover {
  flex: 0 0 96rpx;
  overflow: hidden;
  width: 96rpx;
  height: 128rpx;
  border-radius: var(--radius-small);
}

.add-book__scan-cover book-cover {
  display: block;
  width: 100%;
}

.add-book__scan-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.add-book__scan-title,
.add-book__scan-meta,
.add-book__scan-isbn {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-book__scan-title {
  font-family: var(--font-display);
  font-size: 27rpx;
  font-weight: 700;
}

.add-book__scan-meta,
.add-book__scan-isbn {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.add-book__scan-isbn {
  color: var(--color-text-muted);
  font-size: 19rpx;
}

.add-book__scan-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.add-book__copy-badge {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  color: var(--color-brand-forest);
  background: var(--color-brand-forest-soft);
}

.add-book__status-success {
  color: var(--color-brand-forest);
}

.add-book__status-error {
  overflow: hidden;
  color: var(--color-danger);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-book__remove {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  border: 1rpx solid rgba(169, 65, 63, 0.38);
  border-radius: 50%;
  color: var(--color-danger);
  background: transparent;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.add-book__continuous-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 42rpx;
  padding: 52rpx 28rpx;
  border: 1rpx dashed var(--color-border-default);
  border-radius: var(--radius-medium);
  color: var(--color-text-muted);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.add-book__continuous-empty-title {
  margin-bottom: 8rpx;
  color: var(--color-text-primary);
  font-family: var(--font-display);
  font-size: 29rpx;
  font-weight: 700;
}

.add-book__start-action {
  margin-top: 26rpx;
}

.add-book__stop-action {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.add-book__stop-action button {
  flex: 0 0 220rpx;
}

.add-book__shelf-choice {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--radius-medium);
  color: var(--color-text-primary);
  background: var(--color-surface-primary);
  text-align: left;
}

.add-book__shelf-label,
.add-book__shelf-value {
  display: block;
}

.add-book__shelf-label {
  font-size: 25rpx;
  font-weight: 650;
}

.add-book__shelf-value {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.add-book__shelf-change {
  color: var(--color-brand-forest);
  font-size: 22rpx;
}

.add-book__commit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 38rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-default);
  background: rgba(247, 243, 234, 0.96);
  box-shadow: 0 -12rpx 34rpx rgba(42, 52, 45, 0.08);
}
